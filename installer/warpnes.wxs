<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 3 installer for the Windows (MSVC) build. Built by .github/workflows/build.yml:
    candle -arch x64 -dVersion=26.11.2600 -dSourceDir=<folder with WarpNES.exe> -dResDir=res -dInstallerDir=installer warpnes.wxs
    light -ext WixUIExtension warpnes.wixobj -out WarpNES.msi
  Keep UpgradeCode the same forever: it is what lets a new MSI replace an old install.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="WarpNES"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Jason Brian Hall"
           UpgradeCode="42510CC2-D0A5-4779-8CA7-47590A8EE26D">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="WarpNES - NES emulator"
             Manufacturer="Jason Brian Hall" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of WarpNES is already installed."
                  Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WarpNESIcon" SourceFile="$(var.ResDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="WarpNESIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jasonbrianhall/warpnes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jasonbrianhall/warpnes" />
    <Property Id="ARPCOMMENTS" Value="NES emulator" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerDir)\License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="WarpNES" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WarpNES" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- The program (SDL2 and the C runtime are linked in: no DLLs) -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A106BA96-70A1-40F6-86A9-2C27A755AC98" Win64="yes">
        <File Id="WarpNES_exe" Name="WarpNES.exe" Source="$(var.SourceDir)\WarpNES.exe" KeyPath="yes" />
        <File Id="README_md" Name="README.md" Source="$(var.SourceDir)\README.md" />
        <File Id="LICENSE_md" Name="LICENSE.md" Source="$(var.SourceDir)\LICENSE.md" />
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut. Settings and saves go to %APPDATA%\WarpNES
         (the program does that itself when its folder isn't writable). -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="580EB4AE-7FE4-4B80-BAF5-23955EED994E" Win64="yes">
        <Shortcut Id="StartMenuShortcutMain"
                  Name="WarpNES"
                  Description="WarpNES - NES emulator"
                  Target="[INSTALLFOLDER]WarpNES.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="WarpNESIcon"
                  IconIndex="0" />
        <RemoveFolder Id="ApplicationProgramsFolderRemove" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\WarpNES" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut (msiexec ... DESKTOP_SHORTCUT=0 to leave it out) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0C0E1B92-2704-460F-BAC4-55ACA509366D" Win64="yes">
        <Condition>DESKTOP_SHORTCUT=1</Condition>
        <Shortcut Id="DesktopShortcutMain"
                  Name="WarpNES"
                  Description="WarpNES - NES emulator"
                  Target="[INSTALLFOLDER]WarpNES.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="WarpNESIcon"
                  IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\WarpNES" Name="Desktop"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="WarpNES" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <InstallExecuteSequence>
      <Custom Action="SetARPINSTALLLOCATION" After="InstallValidate" />
    </InstallExecuteSequence>
    <CustomAction Id="SetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" />

  </Product>
</Wix>
